<?xml version="1.0" encoding="utf-8"?>
<!-- 한국어판(0.93-kr12): 내 CQ 송신(TX CQ) 행 - 호박색/다크 오렌지 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <padding
        android:bottom="0dp"
        android:left="3dp"
        android:right="3dp"
        android:top="0dp" />

    <stroke
        android:width="1dp"
        android:color="@color/list_row_stroke_color" />

    <gradient
        android:angle="90"
        android:startColor="@color/list_tx_cq_bg_start_color"
        android:endColor="@color/list_tx_cq_bg_end_color"
        android:type="linear" />

    <corners
        android:bottomLeftRadius="6dp"
        android:bottomRightRadius="6dp"
        android:topLeftRadius="6dp"
        android:topRightRadius="6dp" />
</shape>
