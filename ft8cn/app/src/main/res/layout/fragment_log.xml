<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/logFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/log_panel_background"
        tools:context=".ui.LogFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/log_fragment_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/list_header_bar_color"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <ImageButton
                android:id="@+id/exportImageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/imagebutton_style"
                android:contentDescription="@string/export"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_baseline_save_alt_24"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

            <ImageButton
                android:id="@+id/shareLogImageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/imagebutton_style"
                android:contentDescription="@string/share_logs"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/exportImageButton"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/share_button_icon_24"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />


            <!-- 한국어판(0.93-kr8): 예전 지도(핀) 버튼 자리를 [PSK] 버튼으로 바꿨다.
                 누르면 내 콜사인·그리드를 보여 주고, PSK Reporter 지도와 내 교신 지도로 이어진다. -->
            <TextView
                android:id="@+id/pskGridButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/imagebutton_style"
                android:contentDescription="@string/psk_grid_title"
                android:gravity="center"
                android:minWidth="46dp"
                android:minHeight="32dp"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:text="@string/psk_button_label"
                android:textColor="@color/bar_text_view_color"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/shareLogImageButton"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/inputMycallEdit"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="4dp"
                android:autofillHints=""

                android:background="@drawable/log_callsign_editor_style"
                android:ems="10"
                android:hint="@string/pl_mycall"
                android:inputType="textPersonName|textCapCharacters"
                android:minHeight="32dp"
                android:textColor="@color/bar_text_view_color"
                android:textColorHint="@color/bar_text_view_color"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/logViewStyleimageButton"
                app:layout_constraintStart_toEndOf="@+id/pskGridButton"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="TextContrastCheck,TouchTargetSizeCheck" />

            <ImageButton
                android:id="@+id/logViewStyleimageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/imagebutton_style"
                android:contentDescription="@string/view_style"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/filterImageButton"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_baseline_assignment_ind_24"
                tools:ignore="TouchTargetSizeCheck" />

            <ImageButton
                android:id="@+id/filterImageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/imagebutton_style"
                android:contentDescription="@string/filter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/countImageButton"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_baseline_list_alt_24"
                tools:ignore="TouchTargetSizeCheck" />

            <ImageButton
                android:id="@+id/countImageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/imagebutton_style"
                android:contentDescription="@string/statistical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_baseline_insert_chart_outlined_24" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/logRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/adifImportLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/log_fragment_bar" />

        <!-- 한국어판(0.93-kr16): QRZ·LotW 에서 받은 교신 기록(.adi)을 이 목록으로 넣는 줄.
             위쪽 단추 줄이 이미 빼빼해 목록 아래에 한 줄로 두었다.
             한국어판(0.93-kr17): 같은 줄에 [새 교신만] 단추를 더했다 — 마지막으로 내보낸 뒤
             저장된 교신만 ADIF 로 만들어 공유한다. -->
        <LinearLayout
            android:id="@+id/adifImportLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/list_header_bar_color"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/log_adif_import_hint"
                android:textColor="@color/bar_text_view_color"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/adifExportNewButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/imagebutton_style"
                android:contentDescription="@string/log_export_new"
                android:gravity="center"
                android:minHeight="30dp"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="@string/log_export_new"
                android:textColor="@color/bar_text_view_color"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:ignore="TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/adifImportButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/imagebutton_style"
                android:gravity="center"
                android:minHeight="30dp"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/log_adif_import"
                android:textColor="@color/bar_text_view_color"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>