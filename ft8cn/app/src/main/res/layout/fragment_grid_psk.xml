<?xml version="1.0" encoding="utf-8"?>
<!-- 한국어판(0.93-kr10): 하단 '그리드·PSK' 탭.
     위쪽은 얇은 한 줄 툴바(40dp)만 두고, 나머지 화면은 PSK Reporter 지도가 거의 다 차지한다.
     지도 안의 검색 폼은 지도 위 [설정] 단추로 겹쳐서 연다(웹 쪽 스크립트가 처리한다). -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/log_panel_background"
        android:orientation="vertical">

        <!-- 초슬림 한 줄 툴바: 내 콜사인·그리드·밴드 + 바로 가기 칩 -->
        <HorizontalScrollView
            android:id="@+id/gridHeaderLayout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/list_header_bar_color"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/myCallsignText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/bar_text_view_color"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="DS2YTO" />

                <TextView
                    android:id="@+id/myGridText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/bar_text_view_color"
                    android:textSize="11sp"
                    tools:text="· PM37uu" />

                <TextView
                    android:id="@+id/bandFreqText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/bar_text_view_color"
                    android:textSize="11sp"
                    tools:text="7.074MHz (40m)" />

                <!-- 바로 가기 칩 -->
                <TextView
                    android:id="@+id/qsoMapButton"
                    style="@style/GridPskToolbarChip"
                    android:text="@string/grid_psk_mine_short" />

                <TextView
                    android:id="@+id/statsButton"
                    style="@style/GridPskToolbarChip"
                    android:text="@string/grid_psk_stats_short" />

                <TextView
                    android:id="@+id/adifButton"
                    style="@style/GridPskToolbarChip"
                    android:text="@string/grid_psk_adif_short" />

                <TextView
                    android:id="@+id/refreshMapButton"
                    style="@style/GridPskToolbarChip"
                    android:text="@string/grid_psk_refresh" />

                <TextView
                    android:id="@+id/browserButton"
                    style="@style/GridPskToolbarChip"
                    android:text="@string/grid_psk_browser_short" />

                <TextView
                    android:id="@+id/logToggleButton"
                    style="@style/GridPskToolbarChip"
                    android:text="@string/grid_psk_show_log" />

                <TextView
                    android:id="@+id/gridSettingsButton"
                    style="@style/GridPskToolbarChip"
                    android:text="@string/grid_psk_open_settings"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- PSK Reporter 전파 지도(인터넷이 잡히면 바로 뜬다) -->
            <WebView
                android:id="@+id/pskMapWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/log_panel_background" />

            <!-- 인터넷이 없거나 지도를 열지 못했을 때의 안내 -->
            <LinearLayout
                android:id="@+id/pskOfflineLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/log_panel_background"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/pskOfflineText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/grid_psk_map_offline"
                    android:textColor="@color/text_view_color"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/pskRetryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/grid_psk_retry"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 전체 QSO 로그 목록(스마트폰에서도 기존 로그 기능을 그대로 쓴다) -->
            <LinearLayout
                android:id="@+id/logPanelLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/log_panel_background"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/gridLogContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</layout>
